{
     "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
     "logo": {
          "source": "arch_small",
          "color": {
               "1": "cyan",
               "2": "blue"
          },
          "padding": {
               "top": 1,
               "left": 3
          }
     },
     "display": {
          "separator": " ",
          "color": {
               "separator": "blue",
               "output": "cyan"
          }
     },
     "modules": [
          {
               "type": "title",
               "format": "{#magenta}{1}{#blue}@{#cyan}{2}{#}"
          },
          {
               "type": "separator",
               "string": "{#blue}─────────────────────────────{#}"
          },
          {
               "type": "os",
               "key": "{#blue}󰣇 OS        {#}",
               "format": "{3} {12}"
          },
          {
               "type": "kernel",
               "key": "{#yellow} Kernel    {#}",
               "format": "{2}"
          },
          {
               "type": "packages",
               "key": "{#green}󰏖 Packages  {#}",
               "format": "{1}"
          },
          {
               "type": "shell",
               "key": "{#magenta} Shell     {#}",
               "format": "{2} {3}"
          },
          {
               "type": "wm",
               "key": "{#blue} WM        {#}"
          },
          {
               "type": "terminal",
               "key": "{#yellow} Terminal  {#}"
          },
          {
               "type": "cpu",
               "key": "{#red} CPU       {#}",
               "format": "{1}"
          },
          {
               "type": "gpu",
               "key": "{#green} GPU       {#}",
               "format": "{2}"
          },
          {
               "type": "memory",
               "key": "{#magenta} Memory    {#}",
               "format": "{3} / {2}"
          },
          {
               "type": "disk",
               "key": "{#blue}󰋊 Disk      {#}",
               "format": "{7} / {6} ({11})"
          },
          {
               "type": "uptime",
               "key": "{#cyan}󰅐 Uptime    {#}",
               "format": "{2}h {3}m"
          },
          {
               "type": "separator",
               "string": "{#blue}─────────────────────────────{#}"
          },
          {
               "type": "colors",
               "paddingLeft": 4,
               "symbol": "circle"
          }
     ]
}
