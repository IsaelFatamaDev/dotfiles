#!/bin/bash

# 🚀 Script de Instalación Épica para ArchLinux Setup
# Automatiza la instalación de paquetes y configuración del entorno

# Colores épicos
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
ORANGE='\033[0;33m'
NC='\033[0m'

# Banner épico
show_banner() {
    clear
    echo -e "${PURPLE}"
    echo "███████╗██████╗ ██╗ ██████╗     ███████╗███████╗████████╗██╗   ██╗██████╗ "
    echo "██╔════╝██╔══██╗██║██╔════╝     ██╔════╝██╔════╝╚══██╔══╝██║   ██║██╔══██╗"
    echo "█████╗  ██████╔╝██║██║          ███████╗█████╗     ██║   ██║   ██║██████╔╝"
    echo "██╔══╝  ██╔═══╝ ██║██║          ╚════██║██╔══╝     ██║   ██║   ██║██╔═══╝ "
    echo "███████╗██║     ██║╚██████╗     ███████║███████╗   ██║   ╚██████╔╝██║     "
    echo "╚══════╝╚═╝     ╚═╝ ╚═════╝     ╚══════╝╚══════╝   ╚═╝    ╚═════╝ ╚═╝     "
    echo -e "${CYAN}                     🎨 INSTALADOR AUTOMÁTICO 🎨                   ${NC}"
    echo -e "${YELLOW}                        ¡Para un ArchLinux ÉPICO!                     ${NC}"
    echo
}

# Función para logging
log() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

# Verificar si estamos en Arch Linux
check_arch() {
    if ! command -v pacman &> /dev/null; then
        log_error "Este script está diseñado para Arch Linux!"
        exit 1
    fi
    log_success "Arch Linux detectado! 🎯"
}

# Actualizar sistema
update_system() {
    log "Actualizando sistema..."
    sudo pacman -Syu --noconfirm
    log_success "Sistema actualizado!"
}

# Instalar AUR helper (yay)
install_yay() {
    if ! command -v yay &> /dev/null; then
        log "Instalando yay (AUR helper)..."
        cd /tmp
        git clone https://aur.archlinux.org/yay.git
        cd yay
        makepkg -si --noconfirm
        cd /
        log_success "Yay instalado!"
    else
        log_success "Yay ya está instalado!"
    fi
}

# Instalar paquetes esenciales
install_packages() {
    log "Instalando paquetes esenciales..."

    # Paquetes oficiales
    OFFICIAL_PACKAGES=(
        # Hyprland y dependencias
        "hyprland"
        "hyprpaper"
        "hypridle"
        "hyprlock"
        "xdg-desktop-portal-hyprland"

        # Waybar y utilidades
        "waybar"
        "wofi"
        "swaync"
        "wl-clipboard"

        # Terminal y shell
        "kitty"
        "zsh"
        "zsh-completions"
        "zsh-autosuggestions"
        "zsh-syntax-highlighting"

        # Utilidades del sistema
        "fastfetch"
        "btop"
        "brightnessctl"
        "playerctl"
        "pavucontrol"
        "grim"
        "slurp"
        "swappy"
        "wf-recorder"

        # Fuentes
        "ttf-jetbrains-mono-nerd"
        "ttf-fira-code"
        "noto-fonts"
        "noto-fonts-emoji"

        # Herramientas de desarrollo
        "git"
        "neovim"
        "code"

        # Navegador y apps
        "firefox"
        "nautilus"
        "discord"

        # Multimedia
        "mpv"
        "imv"
        "pipewire"
        "pipewire-alsa"
        "pipewire-pulse"
        "wireplumber"
    )

    log "Instalando ${#OFFICIAL_PACKAGES[@]} paquetes oficiales..."
    sudo pacman -S --needed --noconfirm "${OFFICIAL_PACKAGES[@]}"

    # Paquetes AUR
    AUR_PACKAGES=(
        "hyprshot"
        "wlogout"
        "swaylock-effects"
        "nwg-look"
        "themix-full-git"
    )

    log "Instalando ${#AUR_PACKAGES[@]} paquetes de AUR..."
    yay -S --needed --noconfirm "${AUR_PACKAGES[@]}"

    log_success "Todos los paquetes instalados!"
}

# Configurar servicios
configure_services() {
    log "Configurando servicios..."

    # Habilitar servicios esenciales
    sudo systemctl enable NetworkManager
    sudo systemctl enable bluetooth

    # Configurar audio
    systemctl --user enable pipewire.service
    systemctl --user enable pipewire-pulse.service
    systemctl --user enable wireplumber.service

    log_success "Servicios configurados!"
}

# Instalar Oh My Zsh
install_oh_my_zsh() {
    if [[ ! -d "$HOME/.oh-my-zsh" ]]; then
        log "Instalando Oh My Zsh..."
        sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
        log_success "Oh My Zsh instalado!"
    else
        log_success "Oh My Zsh ya está instalado!"
    fi
}

# Aplicar configuraciones
apply_configs() {
    log "Aplicando configuraciones personalizadas..."

    DOTFILES_DIR="$HOME/dev/config/dotfiles"

    # Crear directorios de configuración
    mkdir -p "$HOME/.config"

    # Crear enlaces simbólicos
    CONFIGS=(
        "hypr:$HOME/.config/hypr"
        "waybar:$HOME/.config/waybar"
        "kitty:$HOME/.config/kitty"
        "wofi:$HOME/.config/wofi"
        "fastfetch:$HOME/.config/fastfetch"
        "btop:$HOME/.config/btop"
        "zellij:$HOME/.config/zellij"
        "swaylock:$HOME/.config/swaylock"
        "zsh/zshrc:$HOME/.zshrc"
    )

    for config in "${CONFIGS[@]}"; do
        IFS=':' read -r source target <<< "$config"
        source_path="$DOTFILES_DIR/$source"

        if [[ -e "$source_path" ]]; then
            # Backup si existe
            if [[ -e "$target" && ! -L "$target" ]]; then
                mv "$target" "${target}.backup"
                log_warn "Respaldado: $target -> ${target}.backup"
            fi

            # Crear enlace
            ln -sf "$source_path" "$target"
            log "Enlazado: $source_path -> $target"
        fi
    done

    # Hacer ejecutables los scripts
    chmod +x "$DOTFILES_DIR/bin/"*

    log_success "Configuraciones aplicadas!"
}

# Configurar shell por defecto
configure_shell() {
    if [[ "$SHELL" != "$(which zsh)" ]]; then
        log "Configurando Zsh como shell por defecto..."
        chsh -s "$(which zsh)"
        log_success "Shell configurado! (Reinicia la sesión para aplicar)"
    else
        log_success "Zsh ya es el shell por defecto!"
    fi
}

# Función principal
main() {
    show_banner

    echo -e "${YELLOW}🚀 ¿Listo para hacer tu ArchLinux ÉPICO?${NC}"
    echo -e "${CYAN}Este script instalará y configurará:${NC}"
    echo -e "  • Hyprland con efectos modernos"
    echo -e "  • Waybar con diseño glassmorphism"
    echo -e "  • Kitty terminal optimizado"
    echo -e "  • Wofi launcher estilizado"
    echo -e "  • Y muchas mejoras más!"
    echo

    read -p "¿Continuar? (y/N): " -n 1 -r
    echo

    if [[ $REPLY =~ ^[Yy]$ ]]; then
        log "🎯 ¡Empezando la instalación épica!"

        check_arch
        update_system
        install_yay
        install_packages
        configure_services
        install_oh_my_zsh
        apply_configs
        configure_shell

        echo
        echo -e "${GREEN}🎉 ¡INSTALACIÓN COMPLETADA! 🎉${NC}"
        echo -e "${CYAN}Tu ArchLinux ahora está ÉPICO! ✨${NC}"
        echo
        echo -e "${YELLOW}Próximos pasos:${NC}"
        echo -e "  1. Reinicia tu sesión"
        echo -e "  2. Inicia Hyprland"
        echo -e "  3. Disfruta tu setup increíble!"
        echo
        echo -e "${PURPLE}Keybinds útiles:${NC}"
        echo -e "  • SUPER + W = Wallpaper aleatorio"
        echo -e "  • SUPER + SHIFT + W = Selector de wallpapers"
        echo -e "  • SUPER + Space = Wofi launcher"
        echo -e "  • SUPER + Return = Kitty terminal"
        echo

    else
        log "Instalación cancelada."
        exit 0
    fi
}

main "$@"
