#!/bin/bash

# 🎨 Wallpaper Switcher Épico para Hyprland
# Script para cambiar wallpapers de forma dinámica con efectos chéveres

WALLPAPER_DIR="$HOME/dev/config/dotfiles/hypr/walls"
HYPRPAPER_CONFIG="$HOME/dev/config/dotfiles/hypr/hyprpaper.conf"
MONITOR="HDMI-A-2"

# Colores para output épico
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Banner épico
show_banner() {
    echo -e "${PURPLE}"
    echo "██╗    ██╗ █████╗ ██╗     ██╗     ██████╗  █████╗ ██████╗ ███████╗██████╗ "
    echo "██║    ██║██╔══██╗██║     ██║     ██╔══██╗██╔══██╗██╔══██╗██╔════╝██╔══██╗"
    echo "██║ █╗ ██║███████║██║     ██║     ██████╔╝███████║██████╔╝█████╗  ██████╔╝"
    echo "██║███╗██║██╔══██║██║     ██║     ██╔═══╝ ██╔══██║██╔═══╝ ██╔══╝  ██╔══██╗"
    echo "╚███╔███╔╝██║  ██║███████╗███████╗██║     ██║  ██║██║     ███████╗██║  ██║"
    echo " ╚══╝╚══╝ ╚═╝  ╚═╝╚══════╝╚══════╝╚═╝     ╚═╝  ╚═╝╚═╝     ╚══════╝╚═╝  ╚═╝"
    echo -e "${CYAN}                     🎨 SWITCHER ÉPICO 🎨                      ${NC}"
    echo
}

# Función para mostrar wallpapers disponibles
list_wallpapers() {
    echo -e "${YELLOW}📁 Wallpapers disponibles:${NC}"
    local i=1
    for file in "$WALLPAPER_DIR"/*.{jpg,jpeg,png,webp} 2>/dev/null; do
        if [[ -f "$file" ]]; then
            echo -e "${GREEN}[$i]${NC} $(basename "$file")"
            ((i++))
        fi
    done
    echo
}

# Función para cambiar wallpaper
change_wallpaper() {
    local wallpaper_path="$1"

    if [[ ! -f "$wallpaper_path" ]]; then
        echo -e "${RED}❌ Error: Wallpaper no encontrado!${NC}"
        return 1
    fi

    echo -e "${BLUE}🔄 Cambiando wallpaper...${NC}"

    # Actualizar hyprpaper config
    cat > "$HYPRPAPER_CONFIG" <<EOF
preload = $wallpaper_path
wallpaper = $MONITOR,$wallpaper_path

# Efectos y configuraciones mejoradas
splash = true
splash_offset = 2.0
ipc = on
EOF

    # Aplicar cambios
    hyprctl hyprpaper preload "$wallpaper_path" 2>/dev/null
    hyprctl hyprpaper wallpaper "$MONITOR,$wallpaper_path" 2>/dev/null

    echo -e "${GREEN}✅ Wallpaper cambiado exitosamente!${NC}"
    echo -e "${CYAN}🖼️  Nuevo wallpaper: $(basename "$wallpaper_path")${NC}"
}

# Función para wallpaper aleatorio
random_wallpaper() {
    local wallpapers=("$WALLPAPER_DIR"/*.{jpg,jpeg,png,webp})
    local valid_wallpapers=()

    for wp in "${wallpapers[@]}"; do
        [[ -f "$wp" ]] && valid_wallpapers+=("$wp")
    done

    if [[ ${#valid_wallpapers[@]} -eq 0 ]]; then
        echo -e "${RED}❌ No se encontraron wallpapers!${NC}"
        return 1
    fi

    local random_wp="${valid_wallpapers[RANDOM % ${#valid_wallpapers[@]}]}"
    echo -e "${PURPLE}🎲 Seleccionando wallpaper aleatorio...${NC}"
    change_wallpaper "$random_wp"
}

# Función principal
main() {
    show_banner

    case "${1:-interactive}" in
        "list")
            list_wallpapers
            ;;
        "random")
            random_wallpaper
            ;;
        "set")
            if [[ -n "$2" ]]; then
                change_wallpaper "$2"
            else
                echo -e "${RED}❌ Uso: $0 set <ruta_del_wallpaper>${NC}"
            fi
            ;;
        "interactive"|"")
            list_wallpapers
            echo -e "${YELLOW}🎯 Selecciona una opción:${NC}"
            echo -e "${GREEN}[r]${NC} Wallpaper aleatorio"
            echo -e "${GREEN}[l]${NC} Listar wallpapers"
            echo -e "${GREEN}[q]${NC} Salir"
            echo
            read -p "Opción: " choice

            case "$choice" in
                "r"|"R")
                    random_wallpaper
                    ;;
                "l"|"L")
                    list_wallpapers
                    ;;
                [1-9]*)
                    local wallpapers=("$WALLPAPER_DIR"/*.{jpg,jpeg,png,webp})
                    local valid_wallpapers=()

                    for wp in "${wallpapers[@]}"; do
                        [[ -f "$wp" ]] && valid_wallpapers+=("$wp")
                    done

                    if [[ $choice -le ${#valid_wallpapers[@]} && $choice -ge 1 ]]; then
                        change_wallpaper "${valid_wallpapers[$((choice-1))]}"
                    else
                        echo -e "${RED}❌ Opción inválida!${NC}"
                    fi
                    ;;
                "q"|"Q")
                    echo -e "${CYAN}👋 ¡Hasta luego!${NC}"
                    ;;
                *)
                    echo -e "${RED}❌ Opción inválida!${NC}"
                    ;;
            esac
            ;;
        *)
            echo -e "${YELLOW}📖 Uso:${NC}"
            echo -e "  $0                  - Modo interactivo"
            echo -e "  $0 list             - Listar wallpapers"
            echo -e "  $0 random           - Wallpaper aleatorio"
            echo -e "  $0 set <archivo>    - Establecer wallpaper específico"
            ;;
    esac
}

main "$@"
