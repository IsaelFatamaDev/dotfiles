{
  "custom/arch": {
    "format": "󰣇",
    "tooltip": true,
    "tooltip-format": "ArchLinux • Click para terminal",
    "on-click": "/usr/bin/kitty",
    "interval": "once"
  },

  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "warp-on-scroll": false,
    "format": "{name}: {windows}",
    "format-window-separator": " ",
    "window-rewrite-default": "󰘔",
    "window-rewrite": {
      "title<.*youtube.*>": "󰗃",
      "class<firefox>": "�",
      "class<google-chrome>": "�",
      "class<code>": "󰨞",
      "class<kitty>": "�",
      "class<nautilus>": "󰉋",
      "class<discord>": "�",
      "class<spotify>": "�",
      "class<steam>": "󰓓",
      "class<gimp>": "󰽉",
      "class<obs>": "󰑋"
    },
    "persistent-workspaces": {
      "1": [ ],
      "2": [ ],
      "3": [ ]

    }
  },

  "custom/window": {
    "format": "{}",
    "max-length": 60,
    "exec": "~/.config/waybar/window-title.sh",
    "interval": 1,
    "tooltip": true,
    "tooltip-format": "Ventana activa",
    "on-click": "hyprctl dispatch killactive"
  }, "custom/separator": {
    "format": "|",
    "interval": "once",
    "tooltip": false
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰈈",
      "deactivated": "󰈉"
    },
    "tooltip": true,
    "tooltip-format-activated": "Suspensión desactivada 🔥",
    "tooltip-format-deactivated": "Suspensión activada 😴"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "{icon}󰂯 {volume}%",
    "format-bluetooth-muted": "󰂲 {icon}",
    "format-muted": "󰖁",
    "format-source": "󰍬 {volume}%",
    "format-source-muted": "󰍭",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰏴",
      "headset": "󰋎",
      "phone": "󰄜",
      "portable": "󰦧",
      "car": "󰄋",
      "default": [ "󰕿", "󰖀", "󰕾" ]
    },
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "scroll-step": 5,
    "tooltip": true,
    "tooltip-format": "Audio: {volume}%\nClick: Control de volumen\nClick derecho: Mutear"
  },

  "network": {
    "format-wifi": "󰤨 {essid}",
    "format-ethernet": "󰈀 {ipaddr}",
    "format-linked": "󰈀 {ifname}",
    "format-disconnected": "󰤭",
    "format-alt": "󰤨 {signalStrength}%",
    "tooltip-format": "Red: {ifname}\nIP: {ipaddr}\nGateway: {gwaddr}",
    "tooltip-format-wifi": "WiFi: {essid}\nSeñal: {signalStrength}%\nFrecuencia: {frequency} MHz\nIP: {ipaddr}",
    "tooltip-format-ethernet": "Ethernet: {ifname}\nVelocidad: {bandwidthDownBits}\nIP: {ipaddr}",
    "tooltip-format-disconnected": "Red desconectada 😢",
    "on-click": "/usr/bin/kitty --title 'Network Manager' -e nmtui",
    "on-click-right": "nm-connection-editor"
  },

  "cpu": {
    "format": "󰘚 {usage}%",
    "interval": 2,
    "tooltip": true,
    "tooltip-format": "CPU: {usage}%\nFrecuencia: {avg_frequency} GHz\nCores: {load}",
    "on-click": "/usr/bin/kitty --title 'System Monitor' -e htop",
    "states": {
      "warning": 70,
      "critical": 90
    }
  },

  "memory": {
    "format": "󰍛 {percentage}%",
    "interval": 2,
    "tooltip": true,
    "tooltip-format": "RAM: {used:0.1f}GB / {total:0.1f}GB ({percentage}%)\nSwap: {swapUsed:0.1f}GB / {swapTotal:0.1f}GB",
    "on-click": "/usr/bin/kitty --title 'System Monitor' -e htop",
    "states": {
      "warning": 70,
      "critical": 90
    }
  },

  "disk": {
    "format": "󰋊 {percentage_used}%",
    "path": "/",
    "interval": 30,
    "tooltip": true,
    "tooltip-format": "Disco: {used} / {total} ({percentage_used}%)\nDisponible: {free}",
    "on-click": "/usr/bin/kitty --title 'Disk Usage' -e ncdu /"
  },

  "temperature": {
    "interval": 2,
    "hwmon-path": "/sys/devices/platform/coretemp.0/hwmon/hwmon4/temp1_input",
    "critical-threshold": 80,
    "format": "{icon} {temperatureC}°C",
    "format-critical": "󰸁 {temperatureC}°C",
    "format-icons": [ "󰜗", "󰔏", "󰸁" ],
    "tooltip": true,
    "tooltip-format": "Temperatura CPU: {temperatureC}°C"
  },

  "custom/gpu": {
    "exec": "nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits 2>/dev/null || echo 'N/A'",
    "format": "󰢮 {}°C",
    "interval": 5,
    "tooltip": true,
    "tooltip-format": "Temperatura GPU: {}°C"
  },

  "hyprland/language": {
    "format": "󰌌 {}",
    "format-en": "EN",
    "format-es": "ES",
    "tooltip": true,
    "tooltip-format": "Idioma del teclado: {}",
    "on-click": "hyprctl switchxkblayout at-translated-set-2-keyboard next"
  },

  "custom/weather": {
    "format": "{}",
    "exec": "curl -s 'wttr.in/?format=1' 2>/dev/null | sed 's/+//g' || echo '🌤️ N/A'",
    "interval": 1800,
    "tooltip": true,
    "tooltip-format": "Clima actual\nActualizado cada 30 min"
  },

  "custom/updates": {
    "format": "󰚰 {}",
    "exec": "checkupdates 2>/dev/null | wc -l || echo '0'",
    "interval": 3600,
    "tooltip": true,
    "tooltip-format": "{} actualizaciones disponibles\nClick para actualizar",
    "on-click": "/usr/bin/kitty --title 'System Update' -e sudo pacman -Syu"
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip": true,
    "tooltip-format": "Menú de energía\nClick para opciones",
    "on-click": "wlogout -b 2 -c 0 -r 0 -L 930 -R 930 -T 300 -B 300 --protocol layer-shell || rofi -show power-menu -modi power-menu:~/.local/bin/rofi-power-menu"
  },

  "clock": {
    "format": "󰥔 {:%H:%M}",
    "format-alt": "󰸗 {:%Y-%m-%d}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "actions": {
      "on-click": "mode",
      "on-click-right": "shift_up",
      "on-click-middle": "shift_down"
    },
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#cba6f7'><b>{}</b></span>",
        "days": "<span color='#cdd6f4'><b>{}</b></span>",
        "weeks": "<span color='#89b4fa'><b>W{}</b></span>",
        "weekdays": "<span color='#f38ba8'><b>{}</b></span>",
        "today": "<span color='#a6e3a1'><b><u>{}</u></b></span>"
      }
    }
  },

  "tray": {
    "icon-size": 18,
    "spacing": 8,
    "tooltip": true,
    "show-passive-items": true,
    "reverse-direction": true
  }
}
